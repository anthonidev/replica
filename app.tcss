Screen {
    layout: horizontal;
    background: #0F111A;
}

Footer {
    dock: bottom;
    background: #090B10;
    color: #4B526D;
}

FooterKey {
    background: #090B10;
    color: #4B526D;
}

Sidebar {
    width: 28;
    dock: left;
    background: #090B10;
}

ContentArea {
    width: 1fr;
    background: #0F111A;
}

LogPanel {
    width: 55;
    background: #0F111A;
}

LogPanel.-hidden {
    display: none;
}

ModalScreen {
    background: #0F111A 70%;
}
