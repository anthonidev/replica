Screen {
    background: #0D0F18;
    layout: vertical;
}

ContentArea {
    height: 1fr;
}

Footer {
    dock: bottom;
    background: #0D0F18;
    color: #45475A;
}

FooterKey {
    background: #0D0F18;
    color: #45475A;
}

FooterKey .footer-key--key {
    color: #89DDFF;
    background: #0D0F18;
}

ModalScreen {
    background: #0D0F18 70%;
}
